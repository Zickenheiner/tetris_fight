<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:tetris_fight.Features.Board.Presentation"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="tetris_fight.Features.Board.Presentation.TwoPlayerView"
             x:DataType="vm:TwoPlayerViewModel"
             Focusable="True">

    <UserControl.Resources>
        <DataTemplate x:Key="BoardTemplate" x:DataType="vm:BoardViewModel">
            <Grid ColumnDefinitions="Auto,Auto,Auto" Background="#0d0d1a"
                  HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Jauge / Sélecteur de sabotage (gauche) -->
                <Grid Grid.Column="0" Width="50" Height="524" Margin="0,0,6,0">

                    <!-- Jauge normale (masquée quand pleine) -->
                    <Grid IsVisible="{Binding IsGaugeVisible}"
                          Width="16" HorizontalAlignment="Center">
                        <Border Background="#111130"
                                BorderBrush="#2e3568"
                                BorderThickness="1"
                                CornerRadius="4"/>
                        <Border Margin="2"
                                Height="520"
                                Background="#0c0f25"
                                CornerRadius="3"
                                VerticalAlignment="Bottom"/>
                        <Border Margin="2"
                                Height="520"
                                VerticalAlignment="Bottom"
                                CornerRadius="3"
                                Opacity="0.95"
                                RenderTransformOrigin="0.5,1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                                    <GradientStop Color="#146B7A" Offset="0"/>
                                    <GradientStop Color="#22B8CF" Offset="0.6"/>
                                    <GradientStop Color="#8FF6FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{Binding SabotageGaugePercent}">
                                    <ScaleTransform.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="ScaleY" Duration="0:0:0.24"/>
                                        </Transitions>
                                    </ScaleTransform.Transitions>
                                </ScaleTransform>
                            </Border.RenderTransform>
                        </Border>
                        <Border Margin="4,4,4,6"
                                Height="514"
                                VerticalAlignment="Bottom"
                                Background="#66E8FDFF"
                                CornerRadius="2"
                                Opacity="0.8"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{Binding SabotageGaugePercent}">
                                    <ScaleTransform.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="ScaleY" Duration="0:0:0.24"/>
                                        </Transitions>
                                    </ScaleTransform.Transitions>
                                </ScaleTransform>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Sélecteur de pièces (visible quand jauge pleine) -->
                    <ItemsControl IsVisible="{Binding IsGaugeFull}"
                                  ItemsSource="{Binding SabotageSelectorItems}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SabotagePieceItemViewModel">
                                <Button Command="{Binding SelectCommand}"
                                        Margin="0,2" Padding="2"
                                        Background="Transparent"
                                        BorderBrush="#5EDBE8" BorderThickness="1"
                                        CornerRadius="2"
                                        Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Style.Animations>
                                                <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="Opacity" Value="0.72"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Button.Styles>
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="4" Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CellViewModel">
                                                <Border Background="{Binding Background}"
                                                        Width="10" Height="10"
                                                        BorderBrush="#1a1a3a"
                                                        BorderThickness="{Binding CellBorderThickness}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Plateau 10×20 -->
                <Grid Grid.Column="1">
                    <Border BorderBrush="#2a2a5a" BorderThickness="2">
                        <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="20" Columns="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CellViewModel">
                                    <Border Background="{Binding Background}"
                                            Width="26" Height="26"
                                            BorderBrush="#1a1a3a" BorderThickness="1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Overlay game over -->
                    <Border IsVisible="{Binding IsGameOver}"
                            Background="#CC000000">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="GAME OVER"
                                       Foreground="#FF4444"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       LetterSpacing="2"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Panneau latéral -->
                <StackPanel Grid.Column="2" Margin="10,0,4,0" Width="80">
                    <TextBlock Text="SUIVANT"
                               Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                               HorizontalAlignment="Center" Margin="0,12,0,10"/>
                    <ItemsControl ItemsSource="{Binding NextPieceCells}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="4" Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CellViewModel">
                                <Border Background="{Binding Background}"
                                        Width="18" Height="18"
                                        BorderBrush="#1a1a3a"
                                        BorderThickness="{Binding CellBorderThickness}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="SCORE"
                               Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                               HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="{Binding Score}"
                               Foreground="#ffffff" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="LIGNES"
                               Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="{Binding LinesCleared}"
                               Foreground="#ffffff" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#0d0d1a">
        <Grid ColumnDefinitions="Auto,50,Auto" x:Name="GameGrid"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50">

            <!-- Plateau joueur -->
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="JOUEUR"
                           Foreground="#00F0F0" FontFamily="Courier New" FontSize="13"
                           FontWeight="Bold" LetterSpacing="3"
                           HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <ContentControl Content="{Binding PlayerBoard}"
                                ContentTemplate="{StaticResource BoardTemplate}"/>
            </StackPanel>

            <!-- Séparateur VS -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="V" Foreground="#333366" FontFamily="Courier New"
                           FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="S" Foreground="#333366" FontFamily="Courier New"
                           FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Plateau IA -->
            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="IA"
                           Foreground="#F0A000" FontFamily="Courier New" FontSize="13"
                           FontWeight="Bold" LetterSpacing="3"
                           HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <ContentControl Content="{Binding AiBoard}"
                                ContentTemplate="{StaticResource BoardTemplate}"/>
            </StackPanel>
        </Grid>

        <!-- Overlay pause -->
        <Border IsVisible="{Binding IsPaused}" Background="#DD000011"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <TextBlock Text="PAUSE"
                           Foreground="#ffffff" FontFamily="Courier New"
                           FontSize="36" FontWeight="Black" LetterSpacing="8"
                           HorizontalAlignment="Center"/>
                <Button Click="OnResumeClick"
                        Width="220" Height="52"
                        Background="#0a0a1e" BorderBrush="#00F0F0" BorderThickness="1"
                        CornerRadius="4" Cursor="Hand">
                    <TextBlock Text="REPRENDRE"
                               Foreground="#00F0F0" FontFamily="Courier New"
                               FontSize="16" FontWeight="Bold" LetterSpacing="3"
                               HorizontalAlignment="Center"/>
                </Button>
                <Button Click="OnQuitClick"
                        Width="220" Height="52"
                        Background="#0a0a1e" BorderBrush="#F04040" BorderThickness="1"
                        CornerRadius="4" Cursor="Hand">
                    <TextBlock Text="QUITTER"
                               Foreground="#F04040" FontFamily="Courier New"
                               FontSize="16" FontWeight="Bold" LetterSpacing="3"
                               HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
