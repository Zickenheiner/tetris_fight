<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:tetris_fight.Features.Board.Presentation"
             x:Class="tetris_fight.Features.Board.Presentation.TwoPlayerView"
             x:DataType="vm:TwoPlayerViewModel"
             Focusable="True">

    <UserControl.Resources>
        <DataTemplate x:Key="BoardTemplate" x:DataType="vm:BoardViewModel">
            <Grid ColumnDefinitions="Auto,Auto" Background="#0d0d1a"
                  HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Plateau 10×20 -->
                <Grid Grid.Column="0">
                    <Border BorderBrush="#2a2a5a" BorderThickness="2">
                        <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="20" Columns="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CellViewModel">
                                    <Border Background="{Binding Background}"
                                            Width="26" Height="26"
                                            BorderBrush="#1a1a3a" BorderThickness="1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Overlay game over -->
                    <Border IsVisible="{Binding IsGameOver}"
                            Background="#CC000000">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="GAME OVER"
                                       Foreground="#FF4444"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       LetterSpacing="2"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Panneau latéral -->
                <StackPanel Grid.Column="1" Margin="10,0,4,0" Width="80">
                    <TextBlock Text="SUIVANT"
                               Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                               HorizontalAlignment="Center" Margin="0,12,0,10"/>
                    <ItemsControl ItemsSource="{Binding NextPieceCells}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="4" Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CellViewModel">
                                <Border Background="{Binding Background}"
                                        Width="18" Height="18"
                                        BorderBrush="#1a1a3a"
                                        BorderThickness="{Binding CellBorderThickness}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="SCORE"
                               Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                               HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="{Binding Score}"
                               Foreground="#ffffff" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="LIGNES"
                               Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="{Binding LinesCleared}"
                               Foreground="#ffffff" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#0d0d1a" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid ColumnDefinitions="Auto,50,Auto">

            <!-- Plateau joueur -->
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="JOUEUR"
                           Foreground="#00F0F0" FontFamily="Courier New" FontSize="13"
                           FontWeight="Bold" LetterSpacing="3"
                           HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <ContentControl Content="{Binding PlayerBoard}"
                                ContentTemplate="{StaticResource BoardTemplate}"/>
            </StackPanel>

            <!-- Séparateur VS -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="V" Foreground="#333366" FontFamily="Courier New"
                           FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="S" Foreground="#333366" FontFamily="Courier New"
                           FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Plateau IA -->
            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="IA"
                           Foreground="#F0A000" FontFamily="Courier New" FontSize="13"
                           FontWeight="Bold" LetterSpacing="3"
                           HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <ContentControl Content="{Binding AiBoard}"
                                ContentTemplate="{StaticResource BoardTemplate}"/>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
