<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:tetris_fight.Features.Board.Presentation"
             x:Class="tetris_fight.Features.Board.Presentation.BoardView"
             x:DataType="vm:BoardViewModel">

    <Grid Background="#0d0d1a">
    <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50">

        <!-- Plateau de jeu 10×20 avec overlay game over -->
        <Grid Grid.Column="0">
            <Border BorderBrush="#2a2a5a" BorderThickness="2">
                <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="20" Columns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CellViewModel">
                            <Border Background="{Binding Background}"
                                    Width="30" Height="30"
                                    BorderBrush="#1a1a3a" BorderThickness="1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Overlay DÉFAITE -->
            <Border IsVisible="{Binding IsGameOver}"
                    Background="#CC000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <TextBlock Text="DÉFAITE"
                               Foreground="#FF4444"
                               FontSize="36"
                               FontWeight="Bold"
                               LetterSpacing="4"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="R — Rejouer"
                               Foreground="#888899"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Échap — Menu principal"
                               Foreground="#888899"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Panneau latéral : pièce suivante + score + lignes -->
        <StackPanel Grid.Column="1" Margin="16,0,8,0" Width="120">
            <TextBlock Text="SUIVANT"
                       Foreground="#aaaacc" FontSize="12" FontWeight="Bold" LetterSpacing="2"
                       HorizontalAlignment="Center" Margin="0,16,0,16"/>
            <ItemsControl ItemsSource="{Binding NextPieceCells}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="4" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CellViewModel">
                        <Border Background="{Binding Background}"
                                Width="24" Height="24"
                                BorderBrush="#1a1a3a"
                                BorderThickness="{Binding CellBorderThickness}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Score -->
            <TextBlock Text="SCORE"
                       Foreground="#aaaacc" FontSize="12" FontWeight="Bold" LetterSpacing="2"
                       HorizontalAlignment="Center" Margin="0,24,0,4"/>
            <TextBlock Text="{Binding Score}"
                       Foreground="#ffffff" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <!-- Lignes -->
            <TextBlock Text="LIGNES"
                       Foreground="#aaaacc" FontSize="12" FontWeight="Bold" LetterSpacing="2"
                       HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <TextBlock Text="{Binding LinesCleared}"
                       Foreground="#ffffff" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </StackPanel>

    </Grid>

    <!-- Overlay pause -->
    <Border IsVisible="{Binding IsPaused}" Background="#DD000011"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <TextBlock Text="PAUSE"
                       Foreground="#ffffff" FontFamily="Courier New"
                       FontSize="36" FontWeight="Black" LetterSpacing="8"
                       HorizontalAlignment="Center"/>
            <Button Name="ResumeButton" Click="OnResumeClick"
                    Width="220" Height="52"
                    Background="#0a0a1e" BorderBrush="#00F0F0" BorderThickness="1"
                    CornerRadius="4" Cursor="Hand">
                <TextBlock Text="REPRENDRE"
                           Foreground="#00F0F0" FontFamily="Courier New"
                           FontSize="16" FontWeight="Bold" LetterSpacing="3"
                           HorizontalAlignment="Center"/>
            </Button>
            <Button Name="QuitButton" Click="OnQuitClick"
                    Width="220" Height="52"
                    Background="#0a0a1e" BorderBrush="#F04040" BorderThickness="1"
                    CornerRadius="4" Cursor="Hand">
                <TextBlock Text="QUITTER"
                           Foreground="#F04040" FontFamily="Courier New"
                           FontSize="16" FontWeight="Bold" LetterSpacing="3"
                           HorizontalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
