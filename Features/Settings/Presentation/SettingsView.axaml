<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:tetris_fight.Features.Settings.Presentation"
             x:Class="tetris_fight.Features.Settings.Presentation.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Focusable="True"
             Width="520" Height="660">

    <UserControl.Styles>
        <Style Selector="TextBlock.settingLabel">
            <Setter Property="Foreground" Value="#b8b8d8"/>
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.keyButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#111130"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#00D7EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#06060e" Offset="0"/>
            <GradientStop Color="#09091a" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Width="440" HorizontalAlignment="Center" Margin="0,34">
            <StackPanel Grid.Row="0" Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="PARAMÈTRES"
                           Foreground="#F0A000"
                           FontFamily="Courier New"
                           FontWeight="Black"
                           FontSize="38"
                           LetterSpacing="5"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#66668a"
                           FontFamily="Courier New"
                           FontSize="11"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,28,0,20">
                <StackPanel Spacing="22">
                <Border Background="#0a0a1e" BorderBrush="#2e3568" BorderThickness="1" CornerRadius="4" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="AUDIO"
                                   Foreground="#00F0F0"
                                   FontFamily="Courier New"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   LetterSpacing="3"/>

                        <Grid ColumnDefinitions="125,*,52" ColumnSpacing="14">
                            <TextBlock Text="MUSIQUE"
                                       Foreground="#b8b8d8"
                                       FontFamily="Courier New"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    Value="{Binding MusicVolumePercent, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding MusicVolumeText}"
                                       Foreground="#ffffff"
                                       FontFamily="Courier New"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#0a0a1e" BorderBrush="#2e3568" BorderThickness="1" CornerRadius="4" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="JEU"
                                   Foreground="#00F080"
                                   FontFamily="Courier New"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   LetterSpacing="3"/>
                        <CheckBox IsChecked="{Binding ShowGhostPiece, Mode=TwoWay}"
                                  Foreground="#d8d8ef"
                                  FontFamily="Courier New"
                                  FontSize="13"
                                  Content="Afficher la pièce fantôme"/>
                    </StackPanel>
                </Border>

                <Border Background="#0a0a1e" BorderBrush="#2e3568" BorderThickness="1" CornerRadius="4" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="CONTRÔLES JOUEUR"
                                   Foreground="#F0A000"
                                   FontFamily="Courier New"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   LetterSpacing="3"/>

                        <Grid ColumnDefinitions="*,96" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                            <TextBlock Text="Déplacer à gauche" Classes="settingLabel"/>
                            <Button Grid.Column="1" Content="{Binding MoveLeftButtonText}" Command="{Binding StartCaptureCommand}" CommandParameter="MoveLeft" Classes="keyButton"/>

                            <TextBlock Grid.Row="1" Text="Déplacer à droite" Classes="settingLabel"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="{Binding MoveRightButtonText}" Command="{Binding StartCaptureCommand}" CommandParameter="MoveRight" Classes="keyButton"/>

                            <TextBlock Grid.Row="2" Text="Descendre" Classes="settingLabel"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="{Binding MoveDownButtonText}" Command="{Binding StartCaptureCommand}" CommandParameter="MoveDown" Classes="keyButton"/>

                            <TextBlock Grid.Row="3" Text="Rotation horaire" Classes="settingLabel"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="{Binding RotateClockwiseButtonText}" Command="{Binding StartCaptureCommand}" CommandParameter="RotateClockwise" Classes="keyButton"/>

                            <TextBlock Grid.Row="4" Text="Rotation antihoraire" Classes="settingLabel"/>
                            <Button Grid.Row="4" Grid.Column="1" Content="{Binding RotateCounterClockwiseButtonText}" Command="{Binding StartCaptureCommand}" CommandParameter="RotateCounterClockwise" Classes="keyButton"/>

                            <TextBlock Grid.Row="5" Text="Hard drop" Classes="settingLabel"/>
                            <Button Grid.Row="5" Grid.Column="1" Content="{Binding HardDropButtonText}" Command="{Binding StartCaptureCommand}" CommandParameter="HardDrop" Classes="keyButton"/>

                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="14">
                <Button Content="RÉINITIALISER"
                        Command="{Binding ResetCommand}"
                        Height="42"
                        Background="#0a0a1e"
                        Foreground="#F04040"
                        BorderBrush="#F04040"
                        BorderThickness="1"
                        FontFamily="Courier New"
                        FontWeight="Bold"
                        Cursor="Hand"/>
                <Button Grid.Column="1"
                        Content="← RETOUR"
                        Click="OnBackClick"
                        Height="42"
                        Background="#0a0a1e"
                        Foreground="#00F0F0"
                        BorderBrush="#00F0F0"
                        BorderThickness="1"
                        FontFamily="Courier New"
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </Grid>
        </Grid>

        <Border IsVisible="{Binding IsDuplicateKeyDialogVisible}"
                Background="#CC000011"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Width="360"
                    Padding="24"
                    Background="#0a0a1e"
                    BorderBrush="#F0A000"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 0 32 6 #55111130">
                <StackPanel Spacing="18">
                    <TextBlock Text="TOUCHE DÉJÀ UTILISÉE"
                               Foreground="#F0A000"
                               FontFamily="Courier New"
                               FontSize="18"
                               FontWeight="Black"
                               LetterSpacing="2"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DuplicateKeyDialogText}"
                               Foreground="#ffffff"
                               FontFamily="Courier New"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <Button Content="OK"
                            Command="{Binding CloseDuplicateKeyDialogCommand}"
                            Width="120"
                            Height="38"
                            Background="#111130"
                            Foreground="#00F0F0"
                            BorderBrush="#00F0F0"
                            BorderThickness="1"
                            FontFamily="Courier New"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
