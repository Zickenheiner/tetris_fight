<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:tetris_fight.Features.Network.Presentation"
             xmlns:boardVm="using:tetris_fight.Features.Board.Presentation"
             x:Class="tetris_fight.Features.Network.Presentation.NetworkGameView"
             x:DataType="vm:NetworkGameViewModel"
             Focusable="True">

    <Grid Background="#0d0d1a">
        <Grid ColumnDefinitions="Auto,60,Auto"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50">

            <!-- Plateau local -->
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="VOUS"
                           Foreground="#00F0F0" FontFamily="Courier New" FontSize="13"
                           FontWeight="Bold" LetterSpacing="3"
                           HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <Grid ColumnDefinitions="Auto,Auto,Auto" Background="#0d0d1a">
                    <!-- Jauge / Sélecteur de sabotage local (gauche) -->
                    <Grid Grid.Column="0" Width="50" Margin="0,0,6,0">

                        <!-- Jauge normale (masquée quand pleine) -->
                        <Border IsVisible="{Binding LocalBoard.IsGaugeVisible}"
                                Background="#111130" CornerRadius="3" Width="14" HorizontalAlignment="Center"/>
                        <Border IsVisible="{Binding LocalBoard.IsGaugeVisible}"
                                Background="#FF6600" CornerRadius="3" Width="14" HorizontalAlignment="Center"
                                RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{Binding LocalBoard.SabotageGaugePercent}"/>
                            </Border.RenderTransform>
                        </Border>

                        <!-- Sélecteur de pièces (visible quand jauge pleine) -->
                        <ItemsControl IsVisible="{Binding LocalBoard.IsGaugeFull}"
                                      ItemsSource="{Binding LocalBoard.SabotageSelectorItems}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="boardVm:SabotagePieceItemViewModel">
                                    <Button Command="{Binding SelectCommand}"
                                            Margin="0,2" Padding="2"
                                            Background="Transparent"
                                            BorderBrush="#2a2a5a" BorderThickness="1"
                                            CornerRadius="2"
                                            Cursor="Hand"
                                            Focusable="False">
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="4" Columns="4"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="boardVm:CellViewModel">
                                                    <Border Background="{Binding Background}"
                                                            Width="10" Height="10"
                                                            BorderBrush="#1a1a3a"
                                                            BorderThickness="{Binding CellBorderThickness}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Border BorderBrush="#2a2a5a" BorderThickness="2">
                            <ItemsControl ItemsSource="{Binding LocalBoard.Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="20" Columns="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="boardVm:CellViewModel">
                                        <Border Background="{Binding Background}"
                                                Width="26" Height="26"
                                                BorderBrush="#1a1a3a" BorderThickness="1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Border IsVisible="{Binding LocalBoard.IsGameOver}" Background="#CC000000">
                            <TextBlock Text="GAME OVER"
                                       Foreground="#FF4444" FontSize="22" FontWeight="Bold"
                                       LetterSpacing="2" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="2" Margin="10,0,4,0" Width="80">
                        <TextBlock Text="SUIVANT"
                                   Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                                   HorizontalAlignment="Center" Margin="0,12,0,10"/>
                        <ItemsControl ItemsSource="{Binding LocalBoard.NextPieceCells}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="4" Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="boardVm:CellViewModel">
                                    <Border Background="{Binding Background}"
                                            Width="18" Height="18"
                                            BorderBrush="#1a1a3a"
                                            BorderThickness="{Binding CellBorderThickness}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="SCORE"
                                   Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                                   HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding LocalBoard.Score}"
                                   Foreground="#ffffff" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="LIGNES"
                                   Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding LocalBoard.LinesCleared}"
                                   Foreground="#ffffff" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Séparateur VS + ping -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="V" Foreground="#333366" FontFamily="Courier New"
                           FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="S" Foreground="#333366" FontFamily="Courier New"
                           FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                <Rectangle Height="1" Width="30" Fill="#222244" Margin="0,6"/>
                <TextBlock Text="PING" Foreground="#444466" FontFamily="Courier New"
                           FontSize="9" LetterSpacing="1" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding PingText}"
                           Foreground="#00cc88" FontFamily="Courier New"
                           FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ConnectionStatus}"
                           Foreground="#555577" FontFamily="Courier New"
                           FontSize="9" LetterSpacing="1"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="50"/>
            </StackPanel>

            <!-- Plateau adversaire -->
            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="ADVERSAIRE"
                           Foreground="#F0A000" FontFamily="Courier New" FontSize="13"
                           FontWeight="Bold" LetterSpacing="3"
                           HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <Grid ColumnDefinitions="Auto,Auto,Auto" Background="#0d0d1a">
                    <!-- Jauge adversaire (affichage seul, pas de sélecteur côté adversaire) -->
                    <Grid Grid.Column="0" Width="50" Margin="0,0,6,0">
                        <Border Background="#111130" CornerRadius="3" Width="14" HorizontalAlignment="Center"/>
                        <Border Background="#FF6600" CornerRadius="3" Width="14" HorizontalAlignment="Center"
                                RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{Binding OpponentBoard.SabotageGaugePercent}"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border IsVisible="{Binding OpponentBoard.IsGaugeFull}"
                                BorderBrush="#FF9900" BorderThickness="1.5"
                                CornerRadius="3" Width="14" HorizontalAlignment="Center"
                                Background="Transparent">
                            <Border.Styles>
                                <Style Selector="Border">
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.7" IterationCount="Infinite" PlaybackDirection="Alternate">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                        </Border>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Border BorderBrush="#2a2a5a" BorderThickness="2">
                            <ItemsControl ItemsSource="{Binding OpponentBoard.Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="20" Columns="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="boardVm:CellViewModel">
                                        <Border Background="{Binding Background}"
                                                Width="26" Height="26"
                                                BorderBrush="#1a1a3a" BorderThickness="1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Border IsVisible="{Binding OpponentBoard.IsGameOver}" Background="#CC000000">
                            <TextBlock Text="GAME OVER"
                                       Foreground="#FF4444" FontSize="22" FontWeight="Bold"
                                       LetterSpacing="2" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="2" Margin="10,0,4,0" Width="80">
                        <TextBlock Text="SUIVANT"
                                   Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                                   HorizontalAlignment="Center" Margin="0,12,0,10"/>
                        <ItemsControl ItemsSource="{Binding OpponentBoard.NextPieceCells}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="4" Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="boardVm:CellViewModel">
                                    <Border Background="{Binding Background}"
                                            Width="18" Height="18"
                                            BorderBrush="#1a1a3a"
                                            BorderThickness="{Binding CellBorderThickness}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="SCORE"
                                   Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                                   HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding OpponentBoard.Score}"
                                   Foreground="#ffffff" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="LIGNES"
                                   Foreground="#aaaacc" FontSize="10" FontWeight="Bold" LetterSpacing="2"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding OpponentBoard.LinesCleared}"
                                   Foreground="#ffffff" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Overlay menu (sans pause) -->
        <Border IsVisible="{Binding IsMenuOpen}" Background="#DD000011"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <TextBlock Text="MENU"
                           Foreground="#ffffff" FontFamily="Courier New"
                           FontSize="36" FontWeight="Black" LetterSpacing="8"
                           HorizontalAlignment="Center"/>
                <Button Click="OnResumeClick"
                        Width="220" Height="52"
                        Background="#0a0a1e" BorderBrush="#00F0F0" BorderThickness="1"
                        CornerRadius="4" Cursor="Hand">
                    <TextBlock Text="REPRENDRE"
                               Foreground="#00F0F0" FontFamily="Courier New"
                               FontSize="16" FontWeight="Bold" LetterSpacing="3"
                               HorizontalAlignment="Center"/>
                </Button>
                <Button Click="OnQuitClick"
                        Width="220" Height="52"
                        Background="#0a0a1e" BorderBrush="#F04040" BorderThickness="1"
                        CornerRadius="4" Cursor="Hand">
                    <TextBlock Text="QUITTER"
                               Foreground="#F04040" FontFamily="Courier New"
                               FontSize="16" FontWeight="Bold" LetterSpacing="3"
                               HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Overlay déconnexion -->
        <Border IsVisible="{Binding IsDisconnected}"
                Background="#DD000011"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <TextBlock Text="CONNEXION PERDUE"
                           Foreground="#FF4444" FontSize="26" FontWeight="Bold"
                           FontFamily="Courier New" LetterSpacing="3"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="L'adversaire s'est déconnecté."
                           Foreground="#CC8888" FontSize="13"
                           FontFamily="Courier New"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="[Échap] pour revenir au menu"
                           Foreground="#666688" FontSize="10"
                           FontFamily="Courier New" LetterSpacing="1"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
